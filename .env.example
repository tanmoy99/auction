# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# "anon public" key (or the newer "publishable" key, starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (or the newer "secret" key, starts with sb_secret_). Never share this one.
SUPABASE_SERVICE_ROLE_KEY=

# Optional integration tests: configure only for a separate disposable test project.
# Never reuse the production URL or service key. See docs/LOCAL-REVIEW.md.
# CRICMATE_TEST_DATABASE=dedicated
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=http://localhost:3102
# TEST_APP_URL=http://localhost:3100
