# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# "anon public" key (or the newer "publishable" key, starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (or the newer "secret" key, starts with sb_secret_). Never share this one.
SUPABASE_SERVICE_ROLE_KEY=
